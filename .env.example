# Participant frontend configuration
VITE_API_BASE=http://localhost:8080
# true lets the cockpit run without Firebase/backend while validating UX.
VITE_DEMO_MODE=true

# Production auth wiring should add Firebase public web config here.
# Never commit service-account credentials or private keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
