# Participant frontend configuration
# Copy to .env.local for local development. Do not commit .env.local.
VITE_DEMO_MODE=false
VITE_API_BASE=https://YOUR-CLOUD-RUN-SERVICE-URL

# Firebase Web App configuration. These identify the Firebase web app; they are not Admin SDK credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
